# Скопируйте в .env или задайте переменные окружения. Секреты в репозиторий не коммитим.
APP_SECRET=замените-на-длинную-случайную-строку   # подпись ссылок на фото; если пусто — генерируется при старте
TELEGRAM_BOT_TOKEN=                                # токен от @BotFather; без него вход через Telegram выключен
SEED_TEST_USERS=1                                  # 0 — не создавать тестовые аккаунты (для публичного стенда)
DEMO_MODE=1                                        # 1 — разрешает демо-имитацию обрыва связи при оформлении
# DATA_DIR=./data                                  # где лежат база и загруженные фото
WEBAPP_URL=                                        # публичный HTTPS-адрес приложения (например, из туннеля Cloudflare)
# TELEGRAM_POLLING=1                               # 1 — бот сам опрашивает Telegram (ответы на /start); 0 — выключить
# OPERATOR_PASSWORD=                               # пароль оператора для публичного стенда (вместе с SEED_TEST_USERS=0)

# Для нативных приложений (iOS/Android/desktop): полный адрес сервера и разрешённые источники
# PUBLIC_BASE_URL=https://picpac.example.com
# CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost,ionic://localhost
